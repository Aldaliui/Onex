    "database": ["Drizzle ORM", "MySQL-compatible schema", "Cloudflare D1"],
    "deployment": ["Cloudflare Pages", "Cloudflare Workers", "Cloudflare D1"],
    "testing": ["Vitest", "TypeScript compiler"]
  },
  "commands": {
    "install": "pnpm install --frozen-lockfile",
    "check": "pnpm check",
    "test": "pnpm test -- --run",
    "build": "pnpm build",
    "dev": "pnpm dev"
  },
  "sourceRoots": {
    "frontend": ["client/src", "client/index.html"],
    "windowRuntime": ["client/src/window-runtime", "server/legacyWindowContracts.ts", "server/onyx.contract.test.ts"],
    "backend": ["server", "server/routers.ts", "server/db.ts"],
    "domain": ["packages/erp-domain-core", "packages/erp-adapters"],
    "schema": ["drizzle/schema.ts", "drizzle", "cloudflare/d1"],
    "cloudflare": ["cloudflare/worker.mjs", "cloudflare/wrangler.jsonc", "cloudflare/document-number-generator.mjs"],
    "documentation": ["README.md", "docs", "RELEASE_NOTES_v1.0.0-rc.1_AR.md"]
  },
  "pages": [
    "client/src/pages/WindowWorkbench.tsx",
    "client/src/pages/AccountingSuite.tsx",
    "client/src/pages/SystemAdministration.tsx",
    "client/src/pages/SystemSetup.tsx",
    "client/src/pages/Home.tsx"
  ],
  "coreServices": [
    "server/accountingCore.ts",
    "server/inventoryKernel.ts",
    "server/documentLifecycle.ts",
    "server/systemAdministration.ts",
    "server/tenantScope.ts",
    "server/erpWorkspaceDb.ts",
    "server/purchaseIntegrationReport.ts",
    "server/eInvoicing.ts",
    "server/backup.ts",
    "server/betasys-accounting-import.ts"
  ],
  "modules": [
    "systemAdministration",
    "companyAndBranchManagement",
    "usersRolesPermissions",
    "masterData",
    "accounting",
    "salesAndCustomers",
    "purchasingAndSuppliers",
    "inventory",
    "paymentsAndVouchers",
    "reports",
    "electronicInvoicing",
    "betasysMigration",
    "legacyWindowWorkbench",
    "backupAndRestore"
