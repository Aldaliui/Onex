  "rules": {
    "doNotInventFinancialBehavior": true,
    "doNotPutOracleAnalysisInProductionBundle": true,
    "enforceCompanyScopeOnServer": true,
    "requireAuditForWrites": true,
    "requireIdempotencyForRetriableWrites": true,
    "requireTestsForGeneratedWindows": true,
    "markUnverifiedWindowsAsNeedsEvidence": true
